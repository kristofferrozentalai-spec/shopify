  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "inter_n7"
      },
      {
        "type": "range",
        "id": "font_size_body",
        "label": "Body font size (px)",
        "min": 12,
        "max": 20,
        "step": 1,
        "default": 16
      },
      {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size scale",
        "options": [
          { "value": "small",  "label": "Small" },
          { "value": "medium", "label": "Medium" },
          { "value": "large",  "label": "Large" }
        ],
        "default": "medium"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page max-width (px)",
        "min": 960,
        "max": 1600,
        "step": 20,
        "default": 1220
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Vertical spacing between sections (px)",
        "min": 24,
        "max": 120,
        "step": 4,
        "default": 64
      },
      {
        "type": "range",
        "id": "border_radius_buttons",
        "label": "Button border radius (px)",
        "min": 0,
        "max": 50,
        "step": 2,
        "default": 50
      },
      {
        "type": "range",
        "id": "border_radius_cards",
        "label": "Card border radius (px)",
        "min": 0,
        "max": 24,
        "step": 2,
        "default": 12
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "color",
