<div class="email-signup section-spacing" style="background: {{ section.settings.bg_color }};">
  <div class="container" style="max-width: 580px; text-align: center;">
    {% if section.settings.title != blank %}
      <h2 class="section-heading">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="email-signup__text">{{ section.settings.text }}</p>
    {% endif %}
    {% form 'customer', id: 'newsletter-form' %}
      {% if form.errors %}
        <p class="email-signup__error">{{ form.errors | default_errors }}</p>
      {% endif %}
      {% if form.posted_successfully? %}
        <p class="email-signup__success">{{ section.settings.success_message }}</p>
      {% else %}
        <div class="email-signup__form">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email"
            class="email-signup__input"
            placeholder="{{ section.settings.placeholder }}"
            required
            autocomplete="email"
            aria-label="{{ section.settings.placeholder }}"
          >
          <button type="submit" class="btn-primary email-signup__btn">
            {{ section.settings.button_label | default: 'Subscribe' }}
          </button>
        </div>
        {% if section.settings.disclaimer != blank %}
          <p class="email-signup__disclaimer">{{ section.settings.disclaimer }}</p>
        {% endif %}
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Get exclusive offers, early access, and tips delivered to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer / privacy note"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a3a2a"
    }
  ],
  "presets": [
    {
      "name": "Email signup"
    }
  ]
}
{% endschema %}
