<section class="section wrap narrow"><h1>{{ 'fard.your_bag' | t }}</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cartrow">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><p class="small">{{ item.variant.title }}</p><a class="link" href="{{ item.url_to_remove }}">{{ 'fard.remove' | t }}</a></div><label><span class="small">{{ 'fard.quantity' | t }}</span><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ item.product.title | escape }}"></label><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="carttotal"><p class="price">{{ 'fard.total' | t }}: {{ cart.total_price | money }}</p><p class="small">{{ 'fard.checkout_note' | t }}</p><button class="btn outline" type="submit" name="update">{{ 'fard.update' | t }}</button><button class="btn" type="submit" name="checkout">{{ 'fard.checkout' | t }} ↗</button></div></form>{% else %}<div class="empty"><p>{{ 'fard.empty' | t }}</p><a class="btn" href="/products/fard-packkuber">{{ 'fard.discover' | t }} ↗</a></div>{% endif %}</section>{% schema %}{"name":"FÄRD cart","settings":[]}{% endschema %}