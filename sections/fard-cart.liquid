<section class="section wrap narrow"><h1>{{ 'fard.your_bag' | t }}</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cartrow">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><p class="small">{{ item.variant.title | escape }}</p>{% if item.selling_plan_allocation %}<p class="small"><strong>{{ 'fard.subscribe' | t }}</strong><br>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% else %}<p class="small">{{ 'fard.one_time' | t }}</p>{% endif %}<p class="small">{{ item.final_price | money }} / {{ 'fard.soap_unit' | t }}</p><a class="link" href="{{ item.url_to_remove }}">{{ 'fard.remove' | t }}</a></div><label><span class="small">{{ 'fard.quantity' | t }}</span><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ item.product.title | escape }}"></label><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="carttotal"><p><a class="link" href="/products/kaki-persimmontval">{{ 'fard.continue_shopping' | t }}</a></p><p class="price">{{ 'fard.total' | t }}: {{ cart.total_price | money }}</p><p class="small">{{ 'fard.checkout_note' | t }}</p><button class="btn outline" type="submit" name="update">{{ 'fard.update' | t }}</button><button class="btn" type="submit" name="checkout">{{ 'fard.checkout' | t }} ↗</button></div></form>{% else %}<div class="empty"><p>{{ 'fard.empty' | t }}</p><a class="btn" href="/products/kaki-persimmontval">{{ 'fard.discover' | t }} ↗</a></div>{% endif %}</section>{% schema %}{"name":"KAKI cart","settings":[]}{% endschema %}