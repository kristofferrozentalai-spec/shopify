<section class="section wrap"><h1>{{ 'fard.collection' | t }}</h1>{% paginate collection.products by 12 %}<div class="cards">{% for product in collection.products %}<a href="{{ product.url }}">{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}<h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></a>{% else %}<p>{{ 'fard.soon' | t }}</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>{% schema %}{"name":"FÄRD collection","settings":[]}{% endschema %}