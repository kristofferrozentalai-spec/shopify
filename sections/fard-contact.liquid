<section class="section wrap narrow"><p class="eyebrow">{{ 'fard.contact_kicker' | t }}</p><h1>{{ page.title }}</h1><p class="muted">{{ 'fard.contact_intro' | t }}</p>{% form 'contact', class: 'form' %}{% if form.posted_successfully? %}<p class="success" role="status">{{ 'fard.sent' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label for="contact-name">{{ 'fard.name' | t }}</label><input id="contact-name" name="contact[name]" autocomplete="name" required><label for="contact-email">{{ 'fard.email' | t }}</label><input id="contact-email" type="email" name="contact[email]" autocomplete="email" required><label for="contact-body">{{ 'fard.message' | t }}</label><textarea id="contact-body" name="contact[body]" required></textarea><p class="small muted">{{ 'fard.contact_privacy' | t }}</p><button class="btn" type="submit">{{ 'fard.send' | t }} ↗</button>{% endform %}</section>{% schema %}{"name":"KAKI contact","settings":[]}{% endschema %}