<section class="hero"><div class="herocopy"><p class="eyebrow">{{ 'fard.password_kicker' | t }}</p><h1>{{ 'fard.password_title_html' | t }}</h1><p class="muted">{{ 'fard.password_copy' | t }}</p><p class="small">{{ 'fard.password_price' | t }}</p><details><summary>{{ 'fard.owner' | t }}</summary>{% form 'storefront_password', class: 'form' %}{{ form.errors | default_errors }}<label for="password">{{ 'fard.password' | t }}</label><input id="password" type="password" name="password" autocomplete="current-password" required><button class="btn" type="submit">{{ 'fard.enter' | t }} ↗</button>{% endform %}</details></div><div class="heroimg">{{ section.settings.hero | image_url: width: 1800 | image_tag: preload: true }}<div class="stamp">{{ 'fard.stamp_html' | t }}</div></div></section><div class="ticker"><span>{{ 'fard.benefit1' | t }}</span><span>{{ 'fard.benefit2' | t }}</span><span>{{ 'fard.benefit3' | t }}</span></div>{% stylesheet %}.template-password .navlinks{display:none}{% endstylesheet %}{% schema %}{"name":"KAKI password","settings":[{"type":"image_picker","id":"hero","label":"Produktbild"}]}{% endschema %}