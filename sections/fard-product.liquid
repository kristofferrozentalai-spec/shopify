<section class="section wrap"><div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'fard.home' | t }}</a> / KAKI Persimmontvål</div><div class="productgrid"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1500 | image_tag: loading: 'lazy' }}{% endfor %}<p class="notice">{{ 'fard.concept_note' | t }}</p></div><div class="productinfo"><p class="eyebrow">KAKI · PERSIMMON</p><h1>{{ product.title }}</h1><p class="muted">{{ 'fard.product_intro' | t }}</p><p class="price">{{ product.price | money }} <span class="small">{{ 'fard.planned_price' | t }}</span></p><p><span class="swatch"></span>{{ 'fard.color' | t }} · <span class="small">{{ 'fard.three' | t }}</span></p>{% assign v = product.selected_or_first_available_variant %}{% if v.available and section.settings.enable_sales %}{% form 'product', product, class: 'purchase' %}<input type="hidden" name="id" value="{{ v.id }}"><label for="quantity">{{ 'fard.quantity' | t }}</label><input id="quantity" type="number" name="quantity" min="1" value="1"><button class="btn" type="submit">{{ 'fard.add' | t }} ↗</button>{% endform %}{% else %}<p class="pill">{{ 'fard.soon' | t }}</p><p class="small muted">{{ 'fard.not_open' | t }}</p><a class="btn" href="/pages/kontakt">{{ 'fard.interest' | t }} ↗</a>{% endif %}<ul class="bullets"><li>{{ 'fard.point1' | t }}</li><li>{{ 'fard.point2' | t }}</li><li>{{ 'fard.point3' | t }}</li></ul><details><summary>{{ 'fard.q0' | t }}</summary><p>{{ 'fard.a0' | t }}</p></details><details><summary>{{ 'fard.q1' | t }}</summary><p>{{ 'fard.a1' | t }}</p></details><details><summary>{{ 'fard.q2' | t }}</summary><p>{{ 'fard.a2' | t }}</p></details><details><summary>{{ 'fard.q3' | t }}</summary><p>{{ 'fard.a3' | t }}</p></details></div></div></section><section class="closing"><h2>{{ 'fard.product_close_html' | t }}</h2><a class="link" href="{{ routes.root_url }}#sa-funkar-det">{{ 'fard.see_how' | t }} ↗</a></section><script type="application/ld+json">{{ product | structured_data }}</script>{% schema %}{"name":"KAKI product","settings":[{"type":"checkbox","id":"enable_sales","label":"Öppna för köp efter lanseringskontroll","default":false}]}{% endschema %}