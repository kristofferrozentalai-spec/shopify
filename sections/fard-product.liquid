<section class="section wrap"><div class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'fard.home' | t }}</a> / KAKI Persimmontvål</div><div class="productgrid"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1500 | image_tag: loading: 'lazy' }}{% endfor %}<p class="notice">{{ 'fard.concept_note' | t }}</p></div><div class="productinfo"><p class="eyebrow">KAKI · PERSIMMON</p><h1>{{ product.title }}</h1><p class="muted">{{ 'fard.product_intro' | t }}</p><p class="price">{{ product.price | money }} <span class="small">{{ 'fard.planned_price' | t }}</span></p><p><span class="swatch"></span>{{ 'fard.color' | t }} · <span class="small">{{ 'fard.three' | t }}</span></p>{% assign v = product.selected_or_first_available_variant %}
<div class="kaki-buy"><h2 class="kaki-buy-title">{{ 'fard.choose_purchase' | t }}</h2>
{% for count in (1..3) %}{% unless count == 2 %}
{% capture purchase_id %}KakiPurchase-{{ section.id }}-{{ count }}{% endcapture %}
{% form 'product', product, id: purchase_id, class: 'kaki-option' %}
<input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="{{ count }}">
<div class="kaki-option-head"><h3>{% if count == 1 %}{{ 'fard.one_soap' | t }}{% else %}{{ 'fard.three_soaps' | t }}{% endif %}</h3><strong>{{ v.price | times: count | money }}</strong></div>
<p class="small">{{ 'fard.one_time' | t }} · {{ v.price | money }} / {{ 'fard.soap_unit' | t }}</p>
<p class="small muted">{% if count == 1 %}{{ 'fard.one_copy' | t }}{% else %}{{ 'fard.three_copy' | t }}{% endif %}</p>
<button class="btn" type="submit" {% unless v.available and section.settings.enable_sales %}disabled{% endunless %}>{% if v.available and section.settings.enable_sales %}{{ 'fard.add' | t }}{% else %}{{ 'fard.soon' | t }}{% endif %}</button>
{% endform %}{% endunless %}{% endfor %}
{% assign recurring_count = 0 %}
{% for allocation in v.selling_plan_allocations %}{% if allocation.selling_plan.recurring_deliveries %}{% assign recurring_count = recurring_count | plus: 1 %}{% endif %}{% endfor %}
{% if recurring_count > 0 %}
{% capture subscription_id %}KakiSubscription-{{ section.id }}{% endcapture %}
{% form 'product', product, id: subscription_id, class: 'kaki-option kaki-subscription' %}
<input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="1">
<h3>{{ 'fard.subscribe' | t }}</h3><p class="small">{{ 'fard.sub_quantity' | t }}</p>
<label for="KakiPlan-{{ section.id }}">{{ 'fard.choose_plan' | t }}</label>
<select id="KakiPlan-{{ section.id }}" name="selling_plan" required>
{% for allocation in v.selling_plan_allocations %}{% if allocation.selling_plan.recurring_deliveries %}<option value="{{ allocation.selling_plan.id }}">{{ allocation.selling_plan.name | escape }} · {{ allocation.price | money }} {{ 'fard.first_delivery' | t }}</option>{% endif %}{% endfor %}
</select>
{% for allocation in v.selling_plan_allocations %}{% if allocation.selling_plan.recurring_deliveries %}<details><summary>{{ allocation.selling_plan.name | escape }}</summary><div class="small"><p>{{ allocation.selling_plan.description }}</p><p>{{ 'fard.initial_price' | t }}: {{ allocation.price | money }}</p>{% for adjustment in allocation.price_adjustments %}<p>{{ 'fard.plan_price' | t }} {{ forloop.index }}: {{ adjustment.price | money }}</p>{% endfor %}</div></details>{% endif %}{% endfor %}
<p class="small">{{ 'fard.recurring_notice' | t }}</p>
<button class="btn" type="submit" {% unless v.available and section.settings.enable_sales %}disabled{% endunless %}>{% if v.available and section.settings.enable_sales %}{{ 'fard.add_subscription' | t }}{% else %}{{ 'fard.soon' | t }}{% endif %}</button>
{% endform %}
{% else %}<div class="kaki-option kaki-subscription"><h3>{{ 'fard.subscribe' | t }}</h3><p class="small muted">{{ 'fard.subscription_pending' | t }}</p><button class="btn" type="button" disabled>{{ 'fard.sub_soon' | t }}</button></div>{% endif %}
<p class="small muted">{{ 'fard.checkout_note' | t }}</p>
{% unless section.settings.enable_sales %}<p class="notice">{{ 'fard.not_open' | t }}</p><a class="link" href="/pages/kontakt">{{ 'fard.interest' | t }}</a>{% endunless %}
</div>
<ul class="bullets"><li>{{ 'fard.point1' | t }}</li><li>{{ 'fard.point2' | t }}</li><li>{{ 'fard.point3' | t }}</li></ul><details><summary>{{ 'fard.q0' | t }}</summary><p>{{ 'fard.a0' | t }}</p></details><details><summary>{{ 'fard.q1' | t }}</summary><p>{{ 'fard.a1' | t }}</p></details><details><summary>{{ 'fard.q2' | t }}</summary><p>{{ 'fard.a2' | t }}</p></details><details><summary>{{ 'fard.q3' | t }}</summary><p>{{ 'fard.a3' | t }}</p></details></div></div></section><section class="section olive" id="persimmon-och-kroppslukt"><div class="wrap"><div class="intro"><p class="eyebrow">{{ 'fard.odor_kicker' | t }}</p><h2>{{ 'fard.odor_title_html' | t }}</h2><p class="muted">{{ 'fard.odor_intro' | t }}</p></div><div class="split"><article><h3>{{ 'fard.odor_why_title' | t }}</h3><p>{{ 'fard.odor_why' | t }}</p></article><article><h3>{{ 'fard.odor_help_title' | t }}</h3><p>{{ 'fard.odor_help' | t }}</p></article></div><p class="notice">{{ 'fard.odor_limit' | t }}</p><p class="small">{{ 'fard.odor_sources_html' | t }}</p></div></section><section class="closing"><h2>{{ 'fard.product_close_html' | t }}</h2><a class="link" href="{{ routes.root_url }}#sa-funkar-det">{{ 'fard.see_how' | t }} ↗</a></section><script type="application/ld+json">{{ product | structured_data }}</script>{% stylesheet %}
.kaki-buy{margin:28px 0}.kaki-buy-title{font:600 20px Arial,sans-serif;letter-spacing:0;line-height:1.3}.kaki-option{padding:22px;margin:12px 0;border:1px solid #aeb6a6;border-radius:10px;background:#fffdf8}.kaki-option-head{display:flex;justify-content:space-between;gap:18px;align-items:baseline}.kaki-option h3{margin:0 0 8px}.kaki-option p{margin:8px 0 14px}.kaki-option .btn{width:100%}.kaki-subscription{background:#e7eadb}.kaki-option select{width:100%;padding:12px;margin:10px 0;background:#fffdf8;border:1px solid #aeb6a6;border-radius:4px}.kaki-option label{font-size:13px}.kaki-option:focus-within{outline:2px solid #39412c;outline-offset:3px}
{% endstylesheet %}{% schema %}{"name":"KAKI product","settings":[{"type":"checkbox","id":"enable_sales","label":"Öppna för köp efter lanseringskontroll","default":false}]}{% endschema %}