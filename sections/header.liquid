<style>
  .site-header { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .site-header__inner {
    height: {{ section.settings.header_height }}px;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
  }
</style>

<header class="site-header">
  <div class="site-header__inner container{% if section.settings.logo_alignment == 'center' %} site-header__inner--centered{% endif %}">

    {% if section.settings.logo_alignment == 'center' %}
      <nav class="site-header__nav">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="site-header__nav-link{% if link.active %} active{% endif %}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          loading="eager"
        >
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% if section.settings.logo_alignment == 'left' %}
      <nav class="site-header__nav">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="site-header__nav-link{% if link.active %} active{% endif %}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="site-header__actions">
      <a href="{{ routes.cart_url }}" class="site-header__cart" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="site-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (px)",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 150
    },
    {
      "type": "select",
      "id": "logo_alignment",
      "label": "Logo position",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Size & spacing"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Inner height (px)",
      "info": "Height of the nav bar itself",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Extra side padding (px)",
      "info": "Added on top of the page container padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
