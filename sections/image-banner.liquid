<style>
  .image-banner-{{ section.id }} { min-height: {{ section.settings.height }}px; }
  @media (max-width: 767px) {
    .image-banner-{{ section.id }} { min-height: {{ section.settings.mobile_height }}px; }
  }
</style>

<div class="image-banner image-banner-{{ section.id }} section-spacing--none" style="position: relative; overflow: hidden;">
  {% if section.settings.image != blank %}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="image-banner__bg image-banner__bg--desktop"
      loading="lazy"
      width="2000"
    >
  {% endif %}

  {% if section.settings.mobile_image != blank %}
    <img
      src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="image-banner__bg image-banner__bg--mobile"
      loading="lazy"
      width="1000"
    >
  {% elsif section.settings.image != blank %}
    {%- comment -%} No mobile image set — reuse desktop but tag it so CSS still works {%- endcomment -%}
  {% endif %}

  <div class="image-banner__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  <div class="image-banner__content container" style="text-align: {{ section.settings.alignment }}; color: {{ section.settings.text_color }};">
    {% if section.settings.subheading != blank %}
      <p class="image-banner__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="image-banner__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="image-banner__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_url != blank %}
      <a href="{{ section.settings.button_url }}" class="btn-primary image-banner__btn" style="margin-top: 28px;">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Displayed on screens narrower than 768px. If left blank, the desktop image is used on all screen sizes."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Min height (px)",
      "min": 200,
      "max": 800,
      "step": 20,
      "default": 480
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile min height (px)",
      "min": 150,
      "max": 700,
      "step": 10,
      "default": 360
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay opacity (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image banner"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "settings": {
        "heading": "Your headline here",
        "button_label": "Shop now"
      }
    }
  ]
}
{% endschema %}

