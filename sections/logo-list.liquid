<div class="logo-list section-spacing" style="background: {{ section.settings.bg_color }};">
  <div class="container">
    {% if section.settings.title != blank %}
      <p class="logo-list__title">{{ section.settings.title }}</p>
    {% endif %}
    <div class="logo-list__grid">
      {% for block in section.blocks %}
        {% if block.settings.logo != blank %}
          <div class="logo-list__item" {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}" target="_blank" rel="noopener" aria-label="{{ block.settings.logo.alt }}">
            {% endif %}
            <img
              src="{{ block.settings.logo | image_url: width: 240 }}"
              alt="{{ block.settings.logo.alt | escape }}"
              width="{{ section.settings.logo_width }}"
              loading="lazy"
              style="opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};"
            >
            {% if block.settings.url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "As seen in"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (px)",
      "min": 60,
      "max": 220,
      "step": 10,
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity (%)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
