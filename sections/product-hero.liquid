{% assign product = section.settings.product %}

<style>
  #product-hero-{{ section.id }} {
    --card-bg:              {{ section.settings.bundle_card_bg }};
    --card-selected-bg:     {{ section.settings.bundle_card_selected_bg }};
    --card-border:          {{ section.settings.bundle_card_border_color }};
    --card-selected-border: {{ section.settings.bundle_card_selected_color }};
    --card-radius:          {{ section.settings.bundle_card_radius }}px;
    --card-padding:         {{ section.settings.bundle_card_padding }}px;
    --gallery-col:          {{ section.settings.gallery_column_width }};
    --purchase-col:         {{ section.settings.purchase_column_width }};
  }
  #product-hero-{{ section.id }} .product-gallery__main {
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
  }
  #product-hero-{{ section.id }} .product-hero__inner {
    grid-template-columns: var(--gallery-col) var(--purchase-col);
  }
  @media (max-width: 900px) {
    #product-hero-{{ section.id }} .product-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="product-hero" id="product-hero-{{ section.id }}">
  <div class="product-hero__inner container">

    {%- comment -%} ── LEFT: IMAGE GALLERY ── {%- endcomment -%}
    <div class="product-gallery" id="product-gallery">
      <div class="product-gallery__main">
        {% if product != blank and product.images.size > 0 %}
          {% for image in product.images %}
            <div class="product-gallery__slide{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
              <img
                src="{{ image | image_url: width: 900 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="900" height="900"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="product-gallery__image"
              >
            </div>
          {% endfor %}
        {% else %}
          <div class="product-gallery__slide active">
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image product-gallery__image--placeholder' }}
          </div>
        {% endif %}

        <button class="product-gallery__arrow product-gallery__arrow--prev" aria-label="Previous image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="product-gallery__arrow product-gallery__arrow--next" aria-label="Next image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      {% if product != blank and product.images.size > 1 %}
        <div class="product-gallery__thumbs" role="list">
          {% for image in product.images %}
            <button
              class="product-gallery__thumb{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
              role="listitem"
            >
              <img
                src="{{ image | image_url: width: 120 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="120" height="120"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {%- comment -%} ── RIGHT: PURCHASE PANEL ── {%- endcomment -%}
    <div class="product-purchase" id="product-purchase">

      {%- comment -%} Reviews {%- endcomment -%}
      {% if section.settings.show_reviews %}
        <div class="product-purchase__reviews">
          <div class="product-purchase__stars">
            {% assign full_stars = section.settings.review_score | floor %}
            {% for i in (1..5) %}
              <svg class="star{% if i <= full_stars %} star--full{% else %} star--empty{% endif %}" width="16" height="16" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <span class="product-purchase__review-count">{{ section.settings.review_count }} {{ section.settings.review_label }}</span>
        </div>
      {% endif %}

      {%- comment -%} Promo text {%- endcomment -%}
      {% if section.settings.promo_text != blank %}
        <div class="product-purchase__promo">{{ section.settings.promo_text }}</div>
      {% endif %}

      <form id="product-form" class="product-form" action="{{ routes.cart_add_url }}" method="post" novalidate>

        {%- comment -%}
          COLOR SWATCH SELECTOR
          Auto-generated from product.variants.
          Each swatch carries data-variant-id and data-image-index so JS can
          update the hidden variant input AND jump the gallery image.
        {%- endcomment -%}
        {% if product != blank %}
          {%- assign _is_default = false -%}
          {%- if product.variants.size == 1 and product.variants.first.title == 'Default Title' -%}
            {%- assign _is_default = true -%}
          {%- endif -%}
          {% unless _is_default %}
            <div class="color-selector">
              <p class="color-selector__label">
                {{ section.settings.color_label | default: 'Färg' }}: <span class="js-color-name"></span>
              </p>
              <div class="color-selector__pills">
                {% for variant in product.variants %}
                  {%- assign v_img_idx = 0 -%}
                  {%- if variant.featured_image -%}
                    {%- for img in product.images -%}
                      {%- if img.id == variant.featured_image.id -%}
                        {%- assign v_img_idx = forloop.index0 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  <button type="button"
                    class="color-swatch{% if forloop.first %} is-selected{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-image-index="{{ v_img_idx }}"
                    data-label="{{ variant.title | escape }}"
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                    {{ variant.title }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endunless %}
        {% endif %}

        {%- comment -%}
          QUANTITY BUNDLE SELECTOR
          Each card sets how many units are added to cart (data-quantity).
          Color is selected independently via the swatches above.
        {%- endcomment -%}
        {% if section.settings.bundle_heading != blank %}
          <p class="bundle-section-label">{{ section.settings.bundle_heading }}</p>
        {% endif %}

        <div class="bundle-options" role="radiogroup" aria-label="Välj antal">

          {%- comment -%} Bundle 1 — always shown {%- endcomment -%}
          <label class="bundle-option bundle-option--selected" data-bundle="1">
            <input type="radio" name="bundle_choice" value="1"
              data-quantity="{{ section.settings.bundle_1_qty | default: 1 }}"
              checked class="bundle-option__radio">
            <div class="bundle-option__inner">
              <div class="bundle-option__header">
                <div class="bundle-option__radio-indicator"></div>
                <div class="bundle-option__title-group">
                  <span class="bundle-option__label">{{ section.settings.bundle_1_label | default: 'Köp 1' }}</span>
                  {% if section.settings.bundle_1_badge != blank %}
                    <span class="bundle-option__badge"
                      style="background:{{ section.settings.bundle_1_badge_bg }};color:{{ section.settings.bundle_1_badge_color }};">
                      {{ section.settings.bundle_1_badge }}
                    </span>
                  {% endif %}
                </div>
                <div class="bundle-option__pricing">
                  {% if section.settings.bundle_1_original != blank %}
                    <span class="bundle-option__original-price">{{ section.settings.bundle_1_original }}</span>
                  {% endif %}
                  <span class="bundle-option__price">{{ section.settings.bundle_1_price }}</span>
                </div>
              </div>
            </div>
          </label>

          {%- comment -%} Bundle 2 — shown when label is set {%- endcomment -%}
          {% if section.settings.bundle_2_label != blank %}
            <label class="bundle-option" data-bundle="2">
              <input type="radio" name="bundle_choice" value="2"
                data-quantity="{{ section.settings.bundle_2_qty | default: 2 }}"
                class="bundle-option__radio">
              <div class="bundle-option__inner">
                <div class="bundle-option__header">
                  <div class="bundle-option__radio-indicator"></div>
                  <div class="bundle-option__title-group">
                    <span class="bundle-option__label">{{ section.settings.bundle_2_label }}</span>
                    {% if section.settings.bundle_2_badge != blank %}
                      <span class="bundle-option__badge"
                        style="background:{{ section.settings.bundle_2_badge_bg }};color:{{ section.settings.bundle_2_badge_color }};">
                        {{ section.settings.bundle_2_badge }}
                      </span>
                    {% endif %}
                  </div>
                  <div class="bundle-option__pricing">
                    {% if section.settings.bundle_2_original != blank %}
                      <span class="bundle-option__original-price">{{ section.settings.bundle_2_original }}</span>
                    {% endif %}
                    <span class="bundle-option__price">{{ section.settings.bundle_2_price }}</span>
                  </div>
                </div>
              </div>
            </label>
          {% endif %}

          {%- comment -%} Bundle 3 — shown when label is set, optional divider above {%- endcomment -%}
          {% if section.settings.bundle_3_label != blank %}
            {% if section.settings.bundle_3_show_divider %}
              <div class="bundle-divider">
                <span>{{ section.settings.bundle_3_divider_text | default: 'ELLER' }}</span>
              </div>
            {% endif %}
            <label class="bundle-option" data-bundle="3">
              <input type="radio" name="bundle_choice" value="3"
                data-quantity="{{ section.settings.bundle_3_qty | default: 3 }}"
                class="bundle-option__radio">
              <div class="bundle-option__inner">
                <div class="bundle-option__header">
                  <div class="bundle-option__radio-indicator"></div>
                  <div class="bundle-option__title-group">
                    <span class="bundle-option__label">{{ section.settings.bundle_3_label }}</span>
                    {% if section.settings.bundle_3_badge != blank %}
                      <span class="bundle-option__badge"
                        style="background:{{ section.settings.bundle_3_badge_bg }};color:{{ section.settings.bundle_3_badge_color }};">
                        {{ section.settings.bundle_3_badge }}
                      </span>
                    {% endif %}
                  </div>
                  <div class="bundle-option__pricing">
                    {% if section.settings.bundle_3_original != blank %}
                      <span class="bundle-option__original-price">{{ section.settings.bundle_3_original }}</span>
                    {% endif %}
                    <span class="bundle-option__price">{{ section.settings.bundle_3_price }}</span>
                  </div>
                </div>
              </div>
            </label>
          {% endif %}

        </div><!-- /.bundle-options -->

        {%- comment -%} Variant ID updated by JS when color swatch is clicked {%- endcomment -%}
        <input type="hidden" name="id" id="selected-variant-id"
          value="{% if product != blank %}{{ product.variants.first.id }}{% endif %}">

        <button type="submit" id="add-to-cart-btn" class="btn-add-to-cart"
          {% if product != blank and product.available == false %}disabled{% endif %}>
          {{ section.settings.cta_text | default: 'Lägg i kundvagn' }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>

        <div class="product-trust">
          {% if section.settings.trust_1 != blank %}
            <span class="product-trust__item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              {{ section.settings.trust_1 }}
            </span>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <span class="product-trust__item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              {{ section.settings.trust_2 }}
            </span>
          {% endif %}
          {% if section.settings.trust_3 != blank %}
            <span class="product-trust__item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              {{ section.settings.trust_3 }}
            </span>
          {% endif %}
        </div>

        {% if section.settings.legal_text != blank %}
          <p class="product-legal">{{ section.settings.legal_text }}</p>
        {% endif %}

      </form>
    </div><!-- /.product-purchase -->

  </div><!-- /.product-hero__inner -->
</section>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "gallery_column_width",
      "label": "Image column width",
      "options": [
        { "value": "1fr",    "label": "Equal split" },
        { "value": "1.1fr",  "label": "Slightly larger" },
        { "value": "1.25fr", "label": "Medium-large" },
        { "value": "1.5fr",  "label": "Large" },
        { "value": "1.75fr", "label": "Extra large" },
        { "value": "2fr",    "label": "2× purchase panel" }
      ],
      "default": "1fr"
    },
    {
      "type": "select",
      "id": "purchase_column_width",
      "label": "Purchase panel width",
      "options": [
        { "value": "1fr",    "label": "Equal" },
        { "value": "1.1fr",  "label": "Slightly wider" },
        { "value": "1.25fr", "label": "Medium-wide" },
        { "value": "1.5fr",  "label": "Wide" }
      ],
      "default": "1fr"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "4 / 5",  "label": "Portrait (4:5)" },
        { "value": "3 / 4",  "label": "Tall portrait (3:4)" },
        { "value": "5 / 4",  "label": "Landscape (5:4)" },
        { "value": "4 / 3",  "label": "Wide (4:3)" },
        { "value": "16 / 9", "label": "Widescreen (16:9)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show star reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "review_score",
      "label": "Star rating",
      "min": 1, "max": 5, "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "2 400+"
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Review label",
      "default": "nöjda kunder"
    },
    {
      "type": "header",
      "content": "Promo text"
    },
    {
      "type": "richtext",
      "id": "promo_text",
      "label": "Promotional text",
      "info": "Shown above the bundles"
    },
    {
      "type": "header",
      "content": "Color selector"
    },
    {
      "type": "text",
      "id": "color_label",
      "label": "Label",
      "default": "Färg",
      "info": "Shown as 'Färg: Matcha green' above the swatches"
    },
    {
      "type": "header",
      "content": "Bundle heading"
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Heading above bundles",
      "default": "Välj antal"
    },
    {
      "type": "header",
      "content": "Bundle 1"
    },
    {
      "type": "text",
      "id": "bundle_1_label",
      "label": "Label",
      "default": "Köp 1"
    },
    {
      "type": "range",
      "id": "bundle_1_qty",
      "label": "Quantity added to cart",
      "min": 1, "max": 20, "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "bundle_1_price",
      "label": "Price",
      "default": "300 kr"
    },
    {
      "type": "text",
      "id": "bundle_1_original",
      "label": "Original price (crossed out)",
      "info": "Leave blank to hide"
    },
    {
      "type": "text",
      "id": "bundle_1_badge",
      "label": "Badge text",
      "default": "FRI FRAKT",
      "info": "Leave blank to hide badge"
    },
    {
      "type": "color",
      "id": "bundle_1_badge_bg",
      "label": "Badge background",
      "default": "#4ade80"
    },
    {
      "type": "color",
      "id": "bundle_1_badge_color",
      "label": "Badge text color",
      "default": "#0a2a16"
    },
    {
      "type": "header",
      "content": "Bundle 2"
    },
    {
      "type": "text",
      "id": "bundle_2_label",
      "label": "Label",
      "default": "Köp 2",
      "info": "Leave blank to hide this bundle"
    },
    {
      "type": "range",
      "id": "bundle_2_qty",
      "label": "Quantity added to cart",
      "min": 1, "max": 20, "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "bundle_2_price",
      "label": "Price",
      "default": "600 kr"
    },
    {
      "type": "text",
      "id": "bundle_2_original",
      "label": "Original price (crossed out)",
      "info": "Leave blank to hide"
    },
    {
      "type": "text",
      "id": "bundle_2_badge",
      "label": "Badge text",
      "default": "BEST VALUE",
      "info": "Leave blank to hide badge"
    },
    {
      "type": "color",
      "id": "bundle_2_badge_bg",
      "label": "Badge background",
      "default": "#4ade80"
    },
    {
      "type": "color",
      "id": "bundle_2_badge_color",
      "label": "Badge text color",
      "default": "#0a2a16"
    },
    {
      "type": "header",
      "content": "Bundle 3"
    },
    {
      "type": "text",
      "id": "bundle_3_label",
      "label": "Label",
      "default": "Köp 3 betala för 2",
      "info": "Leave blank to hide this bundle"
    },
    {
      "type": "range",
      "id": "bundle_3_qty",
      "label": "Quantity added to cart",
      "min": 1, "max": 20, "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "bundle_3_price",
      "label": "Price",
      "default": "600 kr"
    },
    {
      "type": "text",
      "id": "bundle_3_original",
      "label": "Original price (crossed out)",
      "default": "900 kr"
    },
    {
      "type": "text",
      "id": "bundle_3_badge",
      "label": "Badge text",
      "default": "SPARA 33%",
      "info": "Leave blank to hide badge"
    },
    {
      "type": "color",
      "id": "bundle_3_badge_bg",
      "label": "Badge background",
      "default": "#4ade80"
    },
    {
      "type": "color",
      "id": "bundle_3_badge_color",
      "label": "Badge text color",
      "default": "#0a2a16"
    },
    {
      "type": "checkbox",
      "id": "bundle_3_show_divider",
      "label": "Show divider above bundle 3",
      "default": false
    },
    {
      "type": "text",
      "id": "bundle_3_divider_text",
      "label": "Divider text",
      "default": "ELLER"
    },
    {
      "type": "header",
      "content": "CTA button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Lägg i kundvagn"
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust badge 1",
      "default": "Fri frakt"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust badge 2",
      "default": "30 dagars öppet köp"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust badge 3",
      "info": "Leave blank to hide"
    },
    {
      "type": "textarea",
      "id": "legal_text",
      "label": "Legal text",
      "info": "Small print below trust badges"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "bundle_card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bundle_card_selected_bg",
      "label": "Selected card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bundle_card_border_color",
      "label": "Card border color",
      "default": "#e0ddd7"
    },
    {
      "type": "color",
      "id": "bundle_card_selected_color",
      "label": "Selected card border color",
      "default": "#1a3a2a"
    },
    {
      "type": "range",
      "id": "bundle_card_radius",
      "label": "Card corner radius (px)",
      "min": 0, "max": 32, "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "bundle_card_padding",
      "label": "Card padding (px)",
      "min": 8, "max": 40, "step": 2,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product Hero"
    }
  ]
}
{% endschema %}
