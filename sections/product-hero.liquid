{% assign product = section.settings.product %}

{%- comment -%}
  Pre-resolve each bundle's Shopify variant from the product by index.
  Bundle index is 1-based in settings (1 = first variant, 2 = second, etc.).
  Falls back gracefully if the product has fewer variants than configured.
{%- endcomment -%}
{% assign b1_idx = section.settings.bundle_1_variant_index | minus: 1 %}
{% assign b2_idx = section.settings.bundle_2_variant_index | minus: 1 %}
{% assign b3_idx = section.settings.bundle_3_variant_index | minus: 1 %}
{% assign ot_idx = section.settings.one_time_variant_index | minus: 1 %}

{% if product != blank %}
  {% assign b1_variant = product.variants[b1_idx] %}
  {% assign b2_variant = product.variants[b2_idx] %}
  {% assign b3_variant = product.variants[b3_idx] %}
  {% assign ot_variant = product.variants[ot_idx] %}
  {%- comment -%} Default hidden input = first product variant (color swatch will override on load) {%- endcomment -%}
  {% assign default_variant_id = product.variants.first.id %}
{% else %}
  {% assign default_variant_id = '' %}
{% endif %}

<style>
  #product-hero-{{ section.id }} {
    --bundle-card-bg:              {{ section.settings.bundle_card_bg }};
    --bundle-card-selected-bg:     {{ section.settings.bundle_card_selected_bg }};
    --bundle-card-border:          {{ section.settings.bundle_card_border_color }};
    --bundle-card-selected-border: {{ section.settings.bundle_card_selected_color }};
    --bundle-card-radius:          {{ section.settings.bundle_card_radius }}px;
    --bundle-card-padding:         {{ section.settings.bundle_card_padding }}px;
    --gallery-columns:             {{ section.settings.gallery_column_width }};
    --purchase-columns:            {{ section.settings.purchase_column_width }};
  }
  #product-hero-{{ section.id }} .product-gallery__main {
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
  }
  #product-hero-{{ section.id }} .product-hero__inner {
    grid-template-columns: var(--gallery-columns) var(--purchase-columns);
  }
  @media (max-width: 900px) {
    #product-hero-{{ section.id }} .product-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="product-hero" id="product-hero-{{ section.id }}">
  <div class="product-hero__inner container">

    {%- comment -%} ── LEFT: IMAGE GALLERY ── {%- endcomment -%}
    <div class="product-gallery" id="product-gallery">
      <div class="product-gallery__main">
        {% if product != blank and product.images.size > 0 %}
          {% for image in product.images %}
            <div class="product-gallery__slide{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
              <img
                src="{{ image | image_url: width: 900 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="900"
                height="900"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="product-gallery__image"
              >
            </div>
          {% endfor %}
        {% else %}
          <div class="product-gallery__slide active">
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image product-gallery__image--placeholder' }}
          </div>
        {% endif %}

        <button class="product-gallery__arrow product-gallery__arrow--prev" aria-label="Previous image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="product-gallery__arrow product-gallery__arrow--next" aria-label="Next image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      {% if product != blank and product.images.size > 1 %}
        <div class="product-gallery__thumbs" role="list">
          {% for image in product.images %}
            <button
              class="product-gallery__thumb{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
              role="listitem"
            >
              <img
                src="{{ image | image_url: width: 120 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="120"
                height="120"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {%- comment -%} ── RIGHT: PURCHASE PANEL ── {%- endcomment -%}
    <div class="product-purchase" id="product-purchase">

      {%- comment -%} Social proof {%- endcomment -%}
      {% if section.settings.show_reviews %}
        <div class="product-purchase__reviews">
          <div class="product-purchase__stars" aria-label="{{ section.settings.review_score }} out of 5 stars">
            {% assign full_stars = section.settings.review_score | floor %}
            {% for i in (1..5) %}
              {% if i <= full_stars %}
                <svg class="star star--full" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% else %}
                <svg class="star star--empty" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endif %}
            {% endfor %}
          </div>
          <span class="product-purchase__review-count">{{ section.settings.review_count }} {{ section.settings.review_label }}</span>
        </div>
      {% endif %}

      {%- comment -%} Product tabs {%- endcomment -%}
      {% if section.settings.show_tabs and section.settings.tab_1_label != blank %}
        <div class="product-tabs" role="tablist">
          <button class="product-tab active" role="tab" aria-selected="true" data-tab="tab-1">
            {{ section.settings.tab_1_label }}
          </button>
          {% if section.settings.tab_2_label != blank %}
            <button class="product-tab" role="tab" aria-selected="false" data-tab="tab-2">
              {{ section.settings.tab_2_label }}
            </button>
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%} Promo text {%- endcomment -%}
      {% if section.settings.promo_text != blank %}
        <div class="product-purchase__promo">{{ section.settings.promo_text }}</div>
      {% endif %}

      {%- comment -%} Bundle / subscription options {%- endcomment -%}
      <form
        action="{{ routes.cart_add_url }}"
        method="post"
        class="product-form"
        id="product-form"
        data-bundle-option="{{ section.settings.bundle_option_name | escape }}"
        novalidate
      >

        {%- comment -%} Color / variant selector — auto-populated from product variants with gallery sync {%- endcomment -%}
        {%- assign is_default_title = false -%}
        {%- if product != blank and product.options.size == 1 and product.options.first == 'Title' -%}
          {%- assign is_default_title = true -%}
        {%- endif -%}
        {% if product != blank and is_default_title == false %}
          <div class="color-selector">
            <p class="color-selector__label">
              {{ product.options.first | default: 'Variant' }}<span class="color-selector__current js-color-name"></span>
            </p>
            <div class="color-selector__pills">
              {% for variant in product.variants %}
                {%- assign v_img_idx = 0 -%}
                {%- if variant.featured_image -%}
                  {%- for image in product.images -%}
                    {%- if image.id == variant.featured_image.id -%}
                      {%- assign v_img_idx = forloop.index0 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                <button type="button"
                  class="color-swatch{% if forloop.first %} is-selected{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-image-index="{{ v_img_idx }}"
                  data-label="{{ variant.title | escape }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ variant.title }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="bundle-options" role="radiogroup" aria-label="Choose your bundle">

          {%- comment -%}
            Bundle 1
          {%- endcomment -%}
          {% if section.settings.bundle_1_enabled and section.settings.bundle_1_label != blank %}
            {%- assign b1_vid = b1_variant.id | default: '' -%}
            <label class="bundle-option bundle-option--selected" data-bundle="1">
              <input type="radio" name="bundle_choice" value="1"
                data-variant-id="{{ b1_vid }}"
                data-option-value="{{ section.settings.bundle_1_option_value | escape }}"
                data-quantity="{{ section.settings.bundle_1_quantity | default: 1 }}"
                checked
                class="bundle-option__radio">
              <div class="bundle-option__inner">
                <div class="bundle-option__header">
                  <div class="bundle-option__radio-indicator"></div>
                  <div class="bundle-option__title-group">
                    <span class="bundle-option__label">{{ section.settings.bundle_1_label }}</span>
                    {% if section.settings.bundle_1_badge != blank and section.settings.bundle_1_badge_show %}
                      <span class="bundle-option__badge" style="background:{{ section.settings.bundle_1_badge_bg }};color:{{ section.settings.bundle_1_badge_text_color }};border-radius:{{ section.settings.bundle_1_badge_radius }}px;">{{ section.settings.bundle_1_badge }}</span>
                    {% endif %}
                  </div>
                  <div class="bundle-option__pricing">
                    {% if section.settings.bundle_1_original_price != blank %}
                      <span class="bundle-option__original-price">{{ section.settings.bundle_1_original_price }}</span>
                    {% endif %}
                    <span class="bundle-option__price">
                      {% if section.settings.bundle_1_price != blank %}
                        {{ section.settings.bundle_1_price }}
                      {% elsif b1_variant %}
                        {{ b1_variant.price | money }}
                      {% endif %}
                    </span>
                  </div>
                </div>
                {% if section.settings.bundle_1_sublabel != blank or section.settings.bundle_1_unit_price != blank %}
                  <div class="bundle-option__meta">
                    <span class="bundle-option__sublabel">{{ section.settings.bundle_1_sublabel }}</span>
                    {% if section.settings.bundle_1_unit_price != blank %}
                      <span class="bundle-option__unit-price">{{ section.settings.bundle_1_unit_price }}</span>
                    {% endif %}
                  </div>
                {% endif %}
                {% if section.settings.bundle_1_perks != blank %}
                  <ul class="bundle-option__perks">
                    {% assign perks_list = section.settings.bundle_1_perks | split: '|' %}
                    {% for perk in perks_list %}
                      {% unless perk == blank %}
                        <li class="bundle-option__perk">
                          <svg class="perk-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                          {{ perk | strip }}
                        </li>
                      {% endunless %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </label>
          {% endif %}

          {%- comment -%}
            Bundle 2
          {%- endcomment -%}
          {% if section.settings.bundle_2_enabled and section.settings.bundle_2_label != blank %}
            {%- assign b2_vid = b2_variant.id | default: '' -%}
            <label class="bundle-option" data-bundle="2">
              <input type="radio" name="bundle_choice" value="2"
                data-variant-id="{{ b2_vid }}"
                data-option-value="{{ section.settings.bundle_2_option_value | escape }}"
                data-quantity="{{ section.settings.bundle_2_quantity | default: 2 }}"
                class="bundle-option__radio">
              <div class="bundle-option__inner">
                <div class="bundle-option__header">
                  <div class="bundle-option__radio-indicator"></div>
                  <div class="bundle-option__title-group">
                    <span class="bundle-option__label">{{ section.settings.bundle_2_label }}</span>
                    {% if section.settings.bundle_2_badge != blank and section.settings.bundle_2_badge_show %}
                      <span class="bundle-option__badge" style="background:{{ section.settings.bundle_2_badge_bg }};color:{{ section.settings.bundle_2_badge_text_color }};border-radius:{{ section.settings.bundle_2_badge_radius }}px;">{{ section.settings.bundle_2_badge }}</span>
                    {% endif %}
                  </div>
                  <div class="bundle-option__pricing">
                    {% if section.settings.bundle_2_original_price != blank %}
                      <span class="bundle-option__original-price">{{ section.settings.bundle_2_original_price }}</span>
                    {% endif %}
                    <span class="bundle-option__price">
                      {% if section.settings.bundle_2_price != blank %}
                        {{ section.settings.bundle_2_price }}
                      {% elsif b2_variant %}
                        {{ b2_variant.price | money }}
                      {% endif %}
                    </span>
                  </div>
                </div>
                {% if section.settings.bundle_2_sublabel != blank or section.settings.bundle_2_unit_price != blank %}
                  <div class="bundle-option__meta">
                    <span class="bundle-option__sublabel">{{ section.settings.bundle_2_sublabel }}</span>
                    {% if section.settings.bundle_2_unit_price != blank %}
                      <span class="bundle-option__unit-price">{{ section.settings.bundle_2_unit_price }}</span>
                    {% endif %}
                  </div>
                {% endif %}
                {% if section.settings.bundle_2_perks != blank %}
                  <ul class="bundle-option__perks">
                    {% assign perks_list = section.settings.bundle_2_perks | split: '|' %}
                    {% for perk in perks_list %}
                      {% unless perk == blank %}
                        <li class="bundle-option__perk">
                          <svg class="perk-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                          {{ perk | strip }}
                        </li>
                      {% endunless %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </label>
          {% endif %}

          {%- comment -%}
            Bundle 3
          {%- endcomment -%}
          {% if section.settings.bundle_3_enabled and section.settings.bundle_3_label != blank %}
            {%- assign b3_vid = b3_variant.id | default: '' -%}
            <label class="bundle-option" data-bundle="3">
              <input type="radio" name="bundle_choice" value="3"
                data-variant-id="{{ b3_vid }}"
                data-option-value="{{ section.settings.bundle_3_option_value | escape }}"
                data-quantity="{{ section.settings.bundle_3_quantity | default: 3 }}"
                class="bundle-option__radio">
              <div class="bundle-option__inner">
                <div class="bundle-option__header">
                  <div class="bundle-option__radio-indicator"></div>
                  <div class="bundle-option__title-group">
                    <span class="bundle-option__label">{{ section.settings.bundle_3_label }}</span>
                    {% if section.settings.bundle_3_badge != blank and section.settings.bundle_3_badge_show %}
                      <span class="bundle-option__badge" style="background:{{ section.settings.bundle_3_badge_bg }};color:{{ section.settings.bundle_3_badge_text_color }};border-radius:{{ section.settings.bundle_3_badge_radius }}px;">{{ section.settings.bundle_3_badge }}</span>
                    {% endif %}
                  </div>
                  <div class="bundle-option__pricing">
                    {% if section.settings.bundle_3_original_price != blank %}
                      <span class="bundle-option__original-price">{{ section.settings.bundle_3_original_price }}</span>
                    {% endif %}
                    <span class="bundle-option__price">
                      {% if section.settings.bundle_3_price != blank %}
                        {{ section.settings.bundle_3_price }}
                      {% elsif b3_variant %}
                        {{ b3_variant.price | money }}
                      {% endif %}
                    </span>
                  </div>
                </div>
                {% if section.settings.bundle_3_sublabel != blank or section.settings.bundle_3_unit_price != blank %}
                  <div class="bundle-option__meta">
                    <span class="bundle-option__sublabel">{{ section.settings.bundle_3_sublabel }}</span>
                    {% if section.settings.bundle_3_unit_price != blank %}
                      <span class="bundle-option__unit-price">{{ section.settings.bundle_3_unit_price }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </label>
          {% endif %}

          {%- comment -%} — One-time purchase divider — {%- endcomment -%}
          {% if section.settings.show_one_time %}
            {%- assign ot_vid = ot_variant.id | default: '' -%}
            <div class="bundle-divider">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              <span>{{ section.settings.divider_text | default: 'OR' }}</span>
            </div>

            <label class="bundle-option bundle-option--one-time" data-bundle="one-time">
              <input type="radio" name="bundle_choice" value="one-time"
                data-variant-id="{{ ot_vid }}"
                data-option-value="{{ section.settings.one_time_option_value | escape }}"
                data-quantity="1"
                class="bundle-option__radio">
              <div class="bundle-option__inner">
                <div class="bundle-option__header">
                  <div class="bundle-option__radio-indicator"></div>
                  <span class="bundle-option__label">{{ section.settings.one_time_label | default: 'One-time purchase' }}</span>
                  <div class="bundle-option__pricing">
                    <span class="bundle-option__price">
                      {% if section.settings.one_time_price != blank %}
                        {{ section.settings.one_time_price }}
                      {% elsif ot_variant %}
                        {{ ot_variant.price | money }}
                      {% endif %}
                    </span>
                  </div>
                </div>
                {% if section.settings.one_time_unit_price != blank %}
                  <div class="bundle-option__meta">
                    <span class="bundle-option__unit-price">{{ section.settings.one_time_unit_price }}</span>
                  </div>
                {% endif %}
              </div>
            </label>
          {% endif %}

        </div><!-- /.bundle-options -->

        {%- comment -%} Hidden input updated by JS on radio/option change {%- endcomment -%}
        <input type="hidden" name="id" id="selected-variant-id" value="{{ default_variant_id }}">
        <input type="hidden" name="quantity" value="1">

        <button
          type="submit"
          class="btn-add-to-cart"
          id="add-to-cart-btn"
          {% if product != blank and product.available == false %}disabled{% endif %}
        >
          {{ section.settings.cta_text | default: 'Subscribe now' }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>

        <div class="product-trust">
          {% if section.settings.trust_1 != blank %}
            <span class="product-trust__item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              {{ section.settings.trust_1 }}
            </span>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <span class="product-trust__item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              {{ section.settings.trust_2 }}
            </span>
          {% endif %}
        </div>

        {% if section.settings.legal_text != blank %}
          <p class="product-legal">{{ section.settings.legal_text }}</p>
        {% endif %}

      </form>
    </div><!-- /.product-purchase -->

  </div><!-- /.product-hero__inner -->
</section>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "paragraph",
      "content": "Make sure your product has variants set up in Shopify (e.g. 'Single', 'Double', 'One-Time'). Then map each bundle below to the correct variant by number (1 = first variant, 2 = second, etc.)."
    },
    {
      "type": "header",
      "content": "Product options (color, size, etc.)"
    },
    {
      "type": "paragraph",
      "content": "If your product has options like Color or Size, set the option name that represents your bundles below. The other options will appear as selectors on the page."
    },
    {
      "type": "text",
      "id": "bundle_option_name",
      "label": "Bundle option name",
      "info": "Exact name of the option that controls bundles/quantities (e.g. 'Pack size'). Leave blank if your product only has one option type.",
      "default": ""
    },
    {
      "type": "text",
      "id": "bundle_1_option_value",
      "label": "Bundle 1 — option value",
      "info": "The value of the above option that maps to Bundle 1 (e.g. '1-pack', 'Single')"
    },
    {
      "type": "text",
      "id": "bundle_2_option_value",
      "label": "Bundle 2 — option value",
      "info": "e.g. '2-pack', 'Double'"
    },
    {
      "type": "text",
      "id": "bundle_3_option_value",
      "label": "Bundle 3 — option value"
    },
    {
      "type": "text",
      "id": "one_time_option_value",
      "label": "One-time — option value"
    },
    {
      "type": "header",
      "content": "Image size"
    },
    {
      "type": "select",
      "id": "gallery_column_width",
      "label": "Image column width",
      "info": "How much horizontal space the image takes vs the purchase panel",
      "options": [
        { "value": "1fr",   "label": "Small (equal split)" },
        { "value": "1.1fr", "label": "Slightly larger" },
        { "value": "1.25fr","label": "Medium-large" },
        { "value": "1.5fr", "label": "Large" },
        { "value": "1.75fr","label": "Extra large" },
        { "value": "2fr",   "label": "2× purchase panel" }
      ],
      "default": "1fr"
    },
    {
      "type": "select",
      "id": "purchase_column_width",
      "label": "Purchase panel width",
      "info": "How much horizontal space the purchase panel takes",
      "options": [
        { "value": "1fr",   "label": "Equal (matches image)" },
        { "value": "1.1fr", "label": "Slightly wider" },
        { "value": "1.25fr","label": "Medium-wide" },
        { "value": "1.5fr", "label": "Wide" }
      ],
      "default": "1fr"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "4 / 5",  "label": "Portrait (4:5)" },
        { "value": "3 / 4",  "label": "Tall portrait (3:4)" },
        { "value": "2 / 3",  "label": "Extra tall (2:3)" },
        { "value": "5 / 4",  "label": "Landscape (5:4)" },
        { "value": "4 / 3",  "label": "Wide landscape (4:3)" },
        { "value": "16 / 9", "label": "Widescreen (16:9)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show star reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "review_score",
      "label": "Star rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "50,000+"
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Review label",
      "default": "5-star reviews"
    },
    {
      "type": "header",
      "content": "Product Tabs"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show product tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 label",
      "default": "The Pouch"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 label",
      "default": "Travel Packs"
    },
    {
      "type": "header",
      "content": "Promo Text"
    },
    {
      "type": "richtext",
      "id": "promo_text",
      "label": "Promotional text",
