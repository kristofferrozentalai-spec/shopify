<style>
  .social-proof-{{ section.id }} {
    background: {{ section.settings.bg_color }};
  }
  .social-proof-{{ section.id }} .sp-stat__number {
    color: {{ section.settings.accent_color }};
  }
</style>

<section class="social-proof social-proof-{{ section.id }} section-spacing">
  <div class="container">

    {%- comment -%} Heading {%- endcomment -%}
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="sp-header">
        {% if section.settings.subheading != blank %}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Aggregate stats bar {%- endcomment -%}
    {% if section.settings.stat_1_number != blank or section.settings.stat_2_number != blank or section.settings.stat_3_number != blank %}
      <div class="sp-stats">
        {% if section.settings.stat_1_number != blank %}
          <div class="sp-stat">
            <span class="sp-stat__number">{{ section.settings.stat_1_number }}</span>
            <span class="sp-stat__label">{{ section.settings.stat_1_label }}</span>
          </div>
        {% endif %}
        {% if section.settings.stat_2_number != blank %}
          <div class="sp-stat sp-stat--bordered">
            <span class="sp-stat__number">{{ section.settings.stat_2_number }}</span>
            <span class="sp-stat__label">{{ section.settings.stat_2_label }}</span>
          </div>
        {% endif %}
        {% if section.settings.stat_3_number != blank %}
          <div class="sp-stat sp-stat--bordered">
            <span class="sp-stat__number">{{ section.settings.stat_3_number }}</span>
            <span class="sp-stat__label">{{ section.settings.stat_3_label }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Review cards {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="sp-reviews">
        {% for block in section.blocks %}
          <div class="sp-review" {{ block.shopify_attributes }}>

            <div class="sp-review__top">
              {%- comment -%} Stars {%- endcomment -%}
              <div class="sp-review__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                {% for i in (1..5) %}
                  <svg width="15" height="15" viewBox="0 0 24 24">
                    <path fill="{% if i <= block.settings.stars %}#22c55e{% else %}#e0ddd7{% endif %}"
                      d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              {%- comment -%} Verified badge {%- endcomment -%}
              {% if block.settings.verified %}
                <span class="sp-review__verified">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Verifierad köpare
                </span>
              {% endif %}
            </div>

            {%- comment -%} Quote {%- endcomment -%}
            {% if block.settings.quote != blank %}
              <p class="sp-review__quote">"{{ block.settings.quote }}"</p>
            {% endif %}

            {%- comment -%} Author {%- endcomment -%}
            <div class="sp-review__author">
              {% if block.settings.avatar != blank %}
                <img
                  src="{{ block.settings.avatar | image_url: width: 80 }}"
                  alt="{{ block.settings.name | escape }}"
                  width="40" height="40"
                  class="sp-review__avatar"
                  loading="lazy"
                >
              {% else %}
                <div class="sp-review__avatar-placeholder">
                  {{ block.settings.name | slice: 0 | upcase }}
                </div>
              {% endif %}
              <div>
                <p class="sp-review__name">{{ block.settings.name }}</p>
                {% if block.settings.location != blank %}
                  <p class="sp-review__location">{{ block.settings.location }}</p>
                {% endif %}
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Social Proof",
  "tag": "section",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 1, "max": 5, "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "default": "Helt fantastisk produkt! Mina barn lägger ifrån sig mobilen utan protest nu."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo (optional)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Anna L."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location or title",
          "default": "Stockholm"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Vad våra kunder säger"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tusentals familjer har återtagit kontrollen"
    },
    {
      "type": "header",
      "content": "Stats bar"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 — number",
      "default": "4.9 / 5"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 — label",
      "default": "Genomsnittligt betyg"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 — number",
      "default": "2 400+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 — label",
      "default": "Nöjda kunder"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 — number",
      "default": "98%"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 — label",
      "default": "Rekommenderar PAUS"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Stats accent color",
      "default": "#1a3a2a"
    }
  ],
  "presets": [
    {
      "name": "Social Proof",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Helt fantastisk! Barnen lade ifrån sig mobilen direkt. Bästa köpet vi gjort.",
            "name": "Anna L.",
            "location": "Stockholm",
            "stars": 5,
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Äntligen middagar utan mobiler. PAUS har förändrat vår familjestämning totalt.",
            "name": "Erik S.",
            "location": "Göteborg",
            "stars": 5,
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Snyggt och enkelt. Fungerar perfekt som gåva – alla på jobbet ville ha en.",
            "name": "Maria K.",
            "location": "Malmö",
            "stars": 5,
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
