<div class="testimonials section-spacing" style="background: {{ section.settings.bg_color }};">
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="section-header" style="text-align: center;">
        {% if section.settings.subheading != blank %}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        <h2 class="section-heading">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="testimonials__grid">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {% for i in (1..5) %}
              <svg width="14" height="14" viewBox="0 0 24 24"><path fill="#22c55e" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {% endfor %}
          </div>
          {% if block.settings.quote != blank %}
            <p class="testimonial-card__quote">"{{ block.settings.quote }}"</p>
          {% endif %}
          <div class="testimonial-card__author">
            {% if block.settings.avatar != blank %}
              <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.author | escape }}" width="40" height="40" class="testimonial-card__avatar" loading="lazy">
            {% endif %}
            <div>
              {% if block.settings.author != blank %}
                <p class="testimonial-card__name">{{ block.settings.author }}</p>
              {% endif %}
              {% if block.settings.location != blank %}
                <p class="testimonial-card__location">{{ block.settings.location }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This product completely changed my daily routine. Absolutely love it!"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author photo"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location or title",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Real results, real people"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f5f3ef"
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "This product completely changed my daily routine!", "author": "Sarah M.", "location": "Verified buyer" } },
        { "type": "testimonial", "settings": { "quote": "I've tried everything. Nothing works as well as this.", "author": "James R.", "location": "Verified buyer" } },
        { "type": "testimonial", "settings": { "quote": "Best purchase I've made this year. Highly recommend.", "author": "Emma K.", "location": "Verified buyer" } }
      ]
    }
  ]
}
{% endschema %}
