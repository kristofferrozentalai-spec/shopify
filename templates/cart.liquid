<div class="container" style="padding-top:48px; padding-bottom:80px; max-width:640px;">
  <h1 style="font-size:28px; font-weight:800; margin-bottom:32px;">Your Cart</h1>

  {% if cart.item_count == 0 %}
    <p style="color:#666; margin-bottom:24px;">Your cart is empty.</p>
    <a href="{{ routes.root_url }}" class="btn-add-to-cart" style="display:inline-flex; width:auto; padding:16px 32px; text-decoration:none;">
      Continue shopping
    </a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <div style="display:flex; gap:16px; padding:20px 0; border-bottom:1px solid #e0ddd7; align-items:center;">
          {% if item.image %}
            <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" width="100" height="100" style="border-radius:8px; object-fit:cover;">
          {% endif %}
          <div style="flex:1;">
            <p style="font-weight:600; margin-bottom:4px;">{{ item.product.title }}</p>
            {% unless item.variant.title == 'Default Title' %}
              <p style="font-size:13px; color:#666;">{{ item.variant.title }}</p>
            {% endunless %}
            <p style="font-size:14px; margin-top:8px;">Qty: {{ item.quantity }}</p>
          </div>
          <p style="font-weight:700; font-size:16px;">{{ item.final_line_price | money }}</p>
        </div>
      {% endfor %}

      <div style="padding:24px 0; display:flex; justify-content:space-between; align-items:center;">
        <div>
          <p style="font-size:14px; color:#666;">Subtotal</p>
          <p style="font-size:22px; font-weight:800;">{{ cart.total_price | money }}</p>
        </div>
        <button type="submit" name="checkout" class="btn-add-to-cart" style="width:auto; padding:16px 32px;">
          Checkout &rarr;
        </button>
      </div>
    </form>
  {% endif %}
</div>
